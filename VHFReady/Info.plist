		<string>es</string>
		<string>it</string>
		<string>fr</string>
		<string>pt</string>
		<string>de</string>
		<string>nl</string>
		<string>pl</string>
		<string>ru</string>
		<string>sr</string>
		<string>da</string>
		<string>sv</string>
		<string>nb</string>
		<string>fi</string>
		<string>ar</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>
