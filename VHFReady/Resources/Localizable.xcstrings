    "This clears completed lessons, quiz scores and flashcards on this device.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει τα ολοκληρωμένα μαθήματα, τις βαθμολογίες κουίζ και τις κάρτες σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán las lecciones completadas, las puntuaciones y las tarjetas de este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella lezioni completate, punteggi dei quiz e schede su questo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les leçons terminées, les scores des quiz et les cartes sur cet appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga as lições concluídas, as pontuações e os cartões neste dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht abgeschlossene Lektionen, Testergebnisse und Karten auf diesem Gerät."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist voltooide lessen, quizscores en kaarten op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa ukończone lekcje, wyniki quizów i karty na tym urządzeniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет пройденные уроки, результаты тестов и карточки на этом устройстве."
