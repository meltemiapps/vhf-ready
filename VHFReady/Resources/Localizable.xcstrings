    "Disabled and drifting into danger": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακυβέρνητο, παρασύρεται σε κίνδυνο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin gobierno y a la deriva hacia un peligro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In avaria e alla deriva verso un pericolo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désemparé et dérivant vers un danger"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem governo e à deriva para um perigo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manövrierunfähig, treibt in Gefahr"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurloos en drijvend naar gevaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez napędu, dryfuje ku niebezpieczeństwu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряло ход, дрейфует к опасности"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без погона, плута ка опасности"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Manøvreudygtig og driver mod fare"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Manöveroförmögen och driver mot fara"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manøvreringsudyktig og driver mot fare"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjailukyvytön ja ajelehtii kohti vaaraa"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّلة وتنجرف نحو الخطر"
          }
        }
      },
      "extractionState": "manual"
    },
    "VHF Ready is an independent, unofficial revision app. It is not affiliated with, endorsed by, sponsored by or connected to any training organisation, examining body, regulator, government agency or equipment manufacturer.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VHF Ready είναι μια ανεξάρτητη, ανεπίσημη εφαρμογή επανάληψης. Δεν συνδέεται, δεν εγκρίνεται, δεν χορηγείται ούτε σχετίζεται με κανέναν φορέα εκπαίδευσης, εξεταστικό φορέα, ρυθμιστική αρχή, κρατική υπηρεσία ή κατασκευαστή εξοπλισμού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready es una aplicación de repaso independiente y no oficial. No está afiliada, respaldada, patrocinada ni vinculada a ninguna organización de formación, organismo examinador, autoridad reguladora, agencia gubernamental ni fabricante de equipos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready è un'app di ripasso indipendente e non ufficiale. Non è affiliata, approvata, sponsorizzata né collegata ad alcun ente di formazione, ente d'esame, autorità di regolamentazione, agenzia governativa o produttore di apparecchiature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready est une application de révision indépendante et non officielle. Elle n'est ni affiliée, ni approuvée, ni parrainée par aucun organisme de formation, organisme d'examen, autorité de régulation, administration publique ou fabricant d'équipements, et n'a aucun lien avec eux."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A VHF Ready é uma aplicação de revisão independente e não oficial. Não é afiliada, aprovada, patrocinada nem associada a qualquer entidade formadora, entidade examinadora, regulador, organismo público ou fabricante de equipamentos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready ist eine unabhängige, inoffizielle Lern-App. Sie ist mit keiner Ausbildungsorganisation, Prüfungsstelle, Regulierungsbehörde, staatlichen Stelle und keinem Gerätehersteller verbunden und wird von diesen weder unterstützt noch gesponsert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready is een onafhankelijke, onofficiële oefenapp. De app is niet gelieerd aan, goedgekeurd door, gesponsord door of verbonden met enige opleidingsorganisatie, examineninstantie, toezichthouder, overheidsinstantie of fabrikant van apparatuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready to niezależna, nieoficjalna aplikacja do powtórek. Nie jest powiązana, zatwierdzona, sponsorowana ani w żaden sposób związana z jakąkolwiek organizacją szkoleniową, instytucją egzaminacyjną, regulatorem, agencją rządową ani producentem sprzętu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready — независимое неофициальное приложение для повторения материала. Оно не связано, не одобрено, не спонсируется и не аффилировано ни с какой учебной организацией, экзаменационным органом, регулятором, государственным ведомством или производителем оборудования."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready је независна, незванична апликација за понављање градива. Није повезана, одобрена, спонзорисана нити на било који начин у вези са било којом организацијом за обуку, испитним телом, регулатором, државним органом или произвођачем опреме."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready er en uafhængig, uofficiel app til repetition. Den er ikke tilknyttet, godkendt af, sponsoreret af eller forbundet med nogen uddannelsesorganisation, eksamensinstans, myndighed, offentlig instans eller udstyrsproducent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready är en oberoende, inofficiell app för repetition. Den är inte ansluten till, godkänd av, sponsrad av eller kopplad till någon utbildningsorganisation, examinerande organ, tillsynsmyndighet, statlig myndighet eller utrustningstillverkare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready er en uavhengig, uoffisiell app for repetisjon. Den er ikke tilknyttet, godkjent av, sponset av eller knyttet til noen opplæringsorganisasjon, eksamensinstans, tilsynsmyndighet, offentlig etat eller utstyrsprodusent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready on itsenäinen, epävirallinen kertaussovellus. Se ei ole sidoksissa mihinkään koulutusorganisaatioon, tutkintoja järjestävään tahoon, sääntelyviranomaiseen, valtion virastoon tai laitevalmistajaan, eikä mikään niistä ole hyväksynyt tai sponsoroinut sitä."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "VHF Ready تطبيق مراجعة مستقل وغير رسمي. لا يرتبط بأي جهة تدريب أو جهة امتحانات أو هيئة تنظيمية أو جهة حكومية أو شركة مصنّعة للمعدات، ولا تعتمده أو ترعاه أيٌّ منها."
          }
        }
      }
    },
    "It is not a training course, does not award any certificate or licence, and is no substitute for an approved course and assessment. The developer is not a certified instructor. Always follow current official guidance.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αποτελεί εκπαιδευτικό πρόγραμμα, δεν απονέμει πιστοποιητικό ή άδεια και δεν υποκαθιστά ένα εγκεκριμένο πρόγραμμα και αξιολόγηση. Ο δημιουργός δεν είναι πιστοποιημένος εκπαιδευτής. Ακολουθείτε πάντα τις ισχύουσες επίσημες οδηγίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un curso de formación, no otorga ningún certificado ni licencia y no sustituye a un curso y una evaluación aprobados. El desarrollador no es un instructor certificado. Sigue siempre la normativa oficial vigente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un corso di formazione, non rilascia alcun certificato o licenza e non sostituisce un corso e una valutazione approvati. Lo sviluppatore non è un istruttore certificato. Segui sempre le indicazioni ufficiali in vigore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une formation : elle ne délivre aucun certificat ni aucune licence et ne remplace pas une formation et une évaluation agréées. Le développeur n'est pas un formateur certifié. Suivez toujours les consignes officielles en vigueur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é um curso de formação, não atribui qualquer certificado ou licença e não substitui um curso e uma avaliação aprovados. O programador não é um formador certificado. Siga sempre as orientações oficiais em vigor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist kein Ausbildungskurs, verleiht kein Zeugnis und keine Lizenz und ersetzt keinen anerkannten Kurs und keine Prüfung. Der Entwickler ist kein zertifizierter Ausbilder. Befolge stets die aktuellen offiziellen Vorgaben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is geen opleiding, verleent geen certificaat of vergunning en vervangt geen erkende cursus en beoordeling. De ontwikkelaar is geen gecertificeerde instructeur. Volg altijd de actuele officiële richtlijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest to kurs szkoleniowy, nie nadaje żadnego świadectwa ani licencji i nie zastępuje zatwierdzonego kursu i egzaminu. Twórca nie jest certyfikowanym instruktorem. Zawsze stosuj się do aktualnych oficjalnych wytycznych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не учебный курс: приложение не выдаёт сертификатов или лицензий и не заменяет утверждённый курс и экзамен. Разработчик не является сертифицированным инструктором. Всегда следуйте действующим официальным требованиям."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово није курс обуке, не додељује никакво уверење или дозволу и не замењује одобрени курс и испит. Аутор није сертификовани инструктор. Увек се придржавајте важећих званичних смерница."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke et kursus, udsteder ikke noget certifikat eller nogen licens og erstatter ikke et godkendt kursus og en godkendt prøve. Udvikleren er ikke certificeret instruktør. Følg altid gældende officielle retningslinjer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den är ingen utbildning, utfärdar inget certifikat eller tillstånd och ersätter inte en godkänd kurs och examination. Utvecklaren är inte certifierad instruktör. Följ alltid gällande officiella riktlinjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke et kurs, gir ikke noe sertifikat eller noen lisens, og erstatter ikke et godkjent kurs og en godkjent prøve. Utvikleren er ikke sertifisert instruktør. Følg alltid gjeldende offisielle retningslinjer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei ole koulutus, se ei myönnä todistusta tai lupaa eikä korvaa hyväksyttyä kurssia ja koetta. Kehittäjä ei ole sertifioitu kouluttaja. Noudata aina voimassa olevia virallisia ohjeita."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس دورة تدريبية، ولا يمنح أي شهادة أو ترخيص، ولا يغني عن دورة وتقييم معتمدين. المطوّر ليس مدربًا معتمدًا. اتبع دائمًا الإرشادات الرسمية السارية."
          }
        }
      }
    },
    "In a real emergency, follow the instructions of the coastguard and your radio's manual.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε πραγματική έκτακτη ανάγκη, ακολουθήστε τις οδηγίες του λιμενικού σώματος και του εγχειριδίου του ασυρμάτου σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una emergencia real, sigue las instrucciones del servicio de salvamento marítimo y el manual de tu radio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una vera emergenza, segui le istruzioni della guardia costiera e il manuale della tua radio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'urgence réelle, suivez les instructions des secours en mer et le manuel de votre radio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa emergência real, siga as instruções da guarda costeira e o manual do seu rádio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge in einem echten Notfall den Anweisungen der Küstenwache und der Anleitung deines Funkgeräts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg bij een echt noodgeval de instructies van de kustwacht en de handleiding van je marifoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W prawdziwym zagrożeniu postępuj zgodnie z poleceniami straży przybrzeżnej i instrukcją radiotelefonu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В реальной чрезвычайной ситуации следуйте указаниям береговой охраны и инструкции к вашей радиостанции."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "У стварној хитној ситуацији пратите упутства обалске страже и упутство за вашу радио-станицу."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I en reel nødsituation skal du følge kystredningstjenestens anvisninger og manualen til din radio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I en verklig nödsituation ska du följa sjöräddningens instruktioner och radions bruksanvisning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I en reell nødsituasjon skal du følge redningstjenestens instruksjoner og bruksanvisningen for radioen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todellisessa hätätilanteessa noudata meripelastuksen ohjeita ja radiosi käyttöohjetta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في حالة الطوارئ الحقيقية، اتبع تعليمات خفر السواحل ودليل جهاز اللاسلكي الخاص بك."
          }
        }
      }
    },
